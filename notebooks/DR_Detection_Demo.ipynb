   "source": [
    "# Diabetic Retinopathy Detection System\n",
    "## End-to-End Demo Notebook\n",
    "\n",
    "This notebook demonstrates all 8 modules of the DR Detection System."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "sys.path.append(str(Path.cwd().parent))\n",
    "\n",
    "from src.config import CLASSIFIER_PATH, SEGMENTER_PATH, DR_CLASSES, LESION_NAMES\n",
    "from src.inference import DRInference\n",
    "from src.report_generator import generate_report, generate_report_text\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import cv2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check if models exist\n",
    "print(f\"Classifier exists: {CLASSIFIER_PATH.exists()}\")\n",
    "print(f\"Segmenter exists: {SEGMENTER_PATH.exists()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load models and analyze\n",
    "infer = DRInference(CLASSIFIER_PATH, SEGMENTER_PATH)\n",
    "results = infer.analyze(\"path/to/test/image.jpg\")\n",
    "\n",
    "print(f\"DR Class: {results['dr_class']}\")\n",
    "print(f\"Confidence: {results['confidence']*100:.1f}%\")\n",
    "print(f\"Retinal Damage: {results['damage_percentage']:.1f}%\")\n",
    "print(f\"Severity: {results['severity_icon']} {results['severity_label']}\")\n",
    "print(f\"Most affected: {results['most_affected_quadrant']}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display results\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
    "\n",
    "axes[0,0].imshow(results['orig_image'])\n",
    "axes[0,0].set_title('Original Fundus')\n",
    "axes[0,1].imshow(results['segmentation_image'])\n",
    "axes[0,1].set_title('Lesion Segmentation')\n",
    "axes[0,2].imshow(results['heatmap_image'])\n",
    "axes[0,2].set_title('Grad-CAM Heatmap')\n",
    "axes[1,0].imshow(results['quadrant_map'])\n",
    "axes[1,0].set_title('Quadrant Map')\n",
    "\n",
    "for ax in axes.flat:\n",
    "    ax.axis('off')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate report\n",
    "report_text = generate_report_text(results)\n",
    "print(report_text)"
   ]
  }
